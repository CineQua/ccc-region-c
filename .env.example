# Region C — environment configuration
#
# Copy to `.env.local` for development, and set the same variables in your
# hosting provider for production. Both are read at build time, so a change
# requires a rebuild.

# Absolute origin the site is served from, WITHOUT a trailing slash and WITHOUT
# the basePath. Used for canonical URLs, Open Graph tags, the sitemap and
# robots.txt.
#
#   Option A (path):      https://cccusadiocese.org
#   Option B (subdomain): https://region-c.cccusadiocese.org
NEXT_PUBLIC_SITE_URL=https://region-c.cccusadiocese.org

# Deployment sub-path. Leave EMPTY when serving from the root of a host.
# Set to /region-c when serving from cccusadiocese.org/region-c.
NEXT_PUBLIC_BASE_PATH=
